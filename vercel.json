{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "python scripts/minify_html.py",
  "outputDirectory": ".",
  "functions": {
    "api/state.js": {
      "maxDuration": 5
    }
  },
  "rewrites": [
    { "source": "/api/state.json", "destination": "/api/state" }
  ],
  "headers": [
    {
      "source": "/api/state.json",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
